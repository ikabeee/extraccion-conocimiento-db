temperatures_july_first <- c(30, 32, 31, 29, 28, 27, 26)
temperatures_july_second <- c(28,27,29,26,25,24,23)
temperatures_june_thirty <- c(25, 26, 27, 28, 29, 30, 31)
temperatures <- c(temperatures_june_thirty, temperatures_july_first, temperatures_july_second)
cat("Las temperaturas de los ultimos 3 diasm son: ", temperatures[])
temperatures_july_first <- c(30, 32, 31, 29, 28, 27, 26)
temperatures_july_second <- c(28,27,29,26,25,24,23)
temperatures_june_thirty <- c(25, 26, 27, 28, 29, 30, 31)
temperatures <- c(temperatures_june_thirty, temperatures_july_first, temperatures_july_second)
cat("Las temperaturas de los ultimos 3 diasm son: ", temperatures[])
cat("La temperatura minima es: ", min(temperatures))
cat("La temperatura maxima es: ", max(temperatures))
cat("La temperatura promedio es: ", mean(temperatures))
cat("La temperatura mediana es: ", median(temperatures))
cat("La temperatura ordenadas de mayot a menor es: ", sort(temperatures, decreasing = TRUE))
library(tidyverse)
library(caret)
library(Metrics)
tours <- read.csv("data/tours_precio.csv")
setwd("~/Documents/GitHub/extraccion-conocimiento-db/r")
library(tidyverse)
library(caret)
library(Metrics)
tours <- read.csv("data/tours_precio.csv")
str(tours)
summary(tours)
set.seed(123)
indice <- createDataPartition(tours$precio, p = 0.8, list = FALSE)
train <- tours[indice, ]
test <- tours[-indice, ]
modelo2 <- lm(precio ~ distancia_km + duracion_h + personas, data = train)
summary(modelo2)
pred2 <- predict(modelo2, newdata = test)
head(pred2)
resultados_m2 <- data.frame(
Metrica = c("MAE", "RMSE", "R2"),
Valor = c(
mae(test$precio, pred2),
rmse(test$precio, pred2),
cor(test$precio, pred2)^2)
)
print(resultados_m2)
