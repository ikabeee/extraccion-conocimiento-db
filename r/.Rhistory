summary(tours)
set.seed(123)
indice <- createDataPartition(tours$precio, p = 0.8, list = FALSE)
train <- tours[indice, ]
test <- tours[-indice, ]
modelo2 <- lm(precio ~ distancia_km + duracion_h + personas, data = train)
summary(modelo2)
pred2 <- predict(modelo2, newdata = test)
